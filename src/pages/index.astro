---
import HivePage from "../components/hive/HivePage.astro";
import HomeOpenSource from "../components/hive/HomeOpenSource.astro";
import HomeNav from "../components/hive/HomeNav.astro";
import RouteMap from "../components/hive/RouteMap.astro";
import SkyPanel from "../components/hive/SkyPanel.astro";
import HomeClose from "../components/hive/HomeClose.astro";
import HomeTraffic from "../components/hive/HomeTraffic.astro";
import TrafficNote from "../components/hive/TrafficNote.astro";
import { homeApplication, homeDescription, homeTitle } from "../lib/seo/home";
---

<HivePage
  title={homeTitle}
  description={homeDescription}
  openGraph={{ title: homeTitle, card: "summary" }}
  structuredData={homeApplication}
>
  <SkyPanel class="hero-panel" comb top>
    <div class="wrap">
      <HomeNav />
      <div class="hero" id="page-content">
        <div class="copy">
          <p class="kicker">
            <span class="hex" aria-hidden="true"></span>Early access
          </p>
          <h1>Right-sized intelligence for AI agents.</h1>
          <p class="sub">
            Nouli runs each step of your agent on the cheapest option that gives the same answer.
          </p>
          <p class="see">
            <a href="#how">See how it works →</a>
          </p>
        </div>
        <RouteMap
          label="Illustrative: a support agent's steps, each shown on what it runs on"
          class="hero-map"
        />
      </div>
    </div>
    <p class="illus">
      Illustrative · <a href="/examples/">See real examples →</a>
    </p>
  </SkyPanel>

  <section class="wrap traffic" id="how">
    <div class="center" data-reveal>
      <h2>We fit every call to the cheapest route that gets it right</h2>
    </div>
    <HomeTraffic note="#replay-note" />
  </section>

  <section class="wrap" id="open-source">
    <HomeOpenSource />
  </section>

  <HomeClose />

  <div class="wrap">
    <p class="why">
      <img src="/brand/bee.svg" alt="" width="28" height="32" loading="lazy" />
      <span>
        <b>Why a bee?</b> A honeybee swarm chooses its new home from many small scout reports that
        build into one decision.
      </span>
    </p>
    <TrafficNote id="replay-note" class="fine" />
  </div>
</HivePage>

<script>
  import "../client/reveal";
</script>

<style>
  .wrap {
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
  }
  :global(.hero-panel) {
    margin: 12px;
    border-radius: 28px;
  }
  .hero {
    display: grid;
    grid-template-columns: 5.4fr 6.6fr;
    gap: 24px;
    align-items: center;
    min-height: calc(100vh - 110px);
    padding-bottom: 48px;
  }
  .kicker {
    font: 500 12px var(--mono);
    font-stretch: 87%;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--on-sky-soft);
  }
  .hex {
    display: inline-block;
    width: 10px;
    height: 11px;
    margin-right: 8px;
    vertical-align: -1px;
    background: var(--amber);
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
  }
  h1 {
    margin: 16px 0 18px;
    font-weight: 400;
    font-size: clamp(42px, 5vw, 74px);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }
  .sub {
    max-width: 22em;
    font-size: 20px;
    color: var(--on-sky-soft);
  }
  .illus {
    position: absolute;
    right: 28px;
    bottom: 20px;
    font: 11px var(--mono);
    color: var(--on-sky-soft);
  }
  .illus a {
    color: inherit;
    display: inline-block;
    min-height: 24px;
  }
  section {
    padding: 130px 0 0;
  }
  h2 {
    font-weight: 400;
    font-size: clamp(34px, 4.2vw, 58px);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }
  .center {
    text-align: center;
  }
  .center h2 {
    max-width: 14em;
    margin: 0 auto;
  }
  .see {
    margin-top: 28px;
    font-weight: 500;
  }
  .see a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--on-sky);
    text-decoration: none;
  }
  .see a:focus-visible {
    outline: 2px solid var(--on-sky);
    outline-offset: 4px;
  }
  .why {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    align-items: start;
    max-width: 46em;
    margin: 48px auto 0;
    padding: 20px 24px;
    border: 1px solid var(--hive-line);
    border-radius: 14px;
    font-size: 15px;
    color: var(--hive-soft);
  }
  .why b {
    font-weight: 500;
    color: var(--hive-ink);
  }
  .fine {
    max-width: 62em;
    margin: 24px auto 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--hive-soft);
    scroll-margin-top: 96px;
  }
  [data-reveal] {
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }
  [data-reveal][data-waiting] {
    opacity: 0;
    transform: translateY(18px);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      transition: none;
    }
    [data-reveal][data-waiting] {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero {
      padding-top: 20px;
    }
    section {
      padding-top: 80px;
    }
  }
</style>
