---
import { contact, hiveNavigation, repository } from "../../lib/site";
---

<footer class="foot">
  <span>Nouli</span>
  {hiveNavigation.map(({ href, label }) => (
    <a href={href}>{label}</a>
  ))}
  <a href={repository}>GitHub</a>
  <a href={contact.href}>{contact.email}</a>
</footer>

<style>
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
    padding: 24px 0 60px;
    font-size: 14px;
    color: var(--hive-soft);
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: inherit;
  }
</style>
