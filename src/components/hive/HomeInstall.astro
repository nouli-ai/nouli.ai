---
import { installationPlatforms } from "../../lib/installation";
---

<install-tabs class="install" id="install">
  <fieldset class="platforms">
    <legend>Operating system</legend>
    {installationPlatforms.map(({ id, os }) => (
      <>
        <input
          type="radio"
          id={`install-os-${id}`}
          name="install-os"
          value={id}
          checked={id === "macos"}
        />
        <label for={`install-os-${id}`}>{os}</label>
      </>
    ))}
    <div class="commands">
      {installationPlatforms.map(({ id, os, code, label }) => (
        <section class="panel" data-platform={id} aria-label={`${os} installation`}>
          <copy-text class="row">
            <code data-copy-source tabindex="0">
              {code}
            </code>
            <button type="button" class="copy" aria-label={label} data-copy-button>
              Copy
            </button>
            <span class="status" role="status" data-copy-status></span>
          </copy-text>
        </section>
      ))}
    </div>
  </fieldset>
</install-tabs>
<script>
  import "../../client/install-tabs";
  import "../../client/copy-text";
</script>

<style>
  .install {
    display: grid;
    gap: 8px;
    max-width: 600px;
    scroll-margin-top: 24px;
  }
  .platforms {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    min-width: 0;
    margin: 0;
    padding: 5px;
    border: 1px solid var(--sky-line);
    border-radius: 16px;
    background: var(--sky-tint);
    backdrop-filter: blur(10px);
  }
  legend,
  input,
  .status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  label {
    display: grid;
    place-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 10px;
    color: var(--on-sky-soft);
    font: 500 12px var(--mono);
    cursor: pointer;
  }
  input:checked + label {
    color: var(--on-sky);
    background: var(--sky-tint);
    box-shadow: inset 0 0 0 1px var(--sky-line);
  }
  input:focus-visible + label,
  .copy:focus-visible {
    outline: 2px solid var(--on-sky);
    outline-offset: 2px;
  }
  .commands {
    grid-column: 1 / -1;
    min-height: 56px;
    padding: 12px 8px 5px;
  }
  .panel {
    display: none;
  }
  input[value="macos"]:checked ~ .commands [data-platform="macos"],
  input[value="linux"]:checked ~ .commands [data-platform="linux"],
  input[value="windows"]:checked ~ .commands [data-platform="windows"] {
    display: block;
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
  }
  code {
    overflow-x: auto;
    font: 500 12.5px var(--mono);
    font-stretch: 87%;
    white-space: nowrap;
  }
  .copy {
    min-width: 64px;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 9px;
    border: 1px solid var(--sky-line);
    background: none;
    color: inherit;
    font: 500 12px var(--mono);
    cursor: pointer;
  }
  @media (max-width: 600px) {
    code {
      font-size: 12px;
    }
    .commands {
      min-height: 76px;
    }
  }
</style>
