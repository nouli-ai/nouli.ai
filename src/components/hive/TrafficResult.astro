---
import { percent, wildchat } from "../../lib/traffic";

interface Props {
  /** Where the footnote that explains the replay lives. */
  note: string;
}
const { note } = Astro.props;
---

<p class="result">
  <span>
    <b>{percent(wildchat.savings.both)} lower cost</b>
    <a class="star" href={note} aria-label="How we measured this">
      *
    </a>
  </span>
</p>

<style>
  .result {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 28px;
    margin-top: 14px;
    font-size: 20px;
    color: var(--hive-soft);
  }
  b {
    font-weight: 500;
    color: var(--hive-ink);
  }
  .star {
    display: inline-block;
    min-width: 24px;
    min-height: 24px;
    margin-left: 2px;
    color: var(--amber-ink);
  }
  a:focus-visible {
    outline: 2px solid var(--amber-ink);
    outline-offset: 2px;
  }
</style>
